#!/usr/bin/env bash
# Перед коммитом: text/*.list → bin/*.mrs и добавить .mrs в индекс.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

TEXT_DIR="rule-sets/mrs/text"
BIN_DIR="rule-sets/mrs/bin"

# Нет vendored mrs — ничего не делаем
[[ -d "$TEXT_DIR" ]] || exit 0

needs_pack=0
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^rule-sets/mrs/text/.*\.list$'; then
  needs_pack=1
fi

# Распакованный text новее bin, но не в индексе — тоже упаковать
while IFS= read -r -d '' f; do
  base="$(basename "$f" .list)"
  bin="$BIN_DIR/${base}.mrs"
  if [[ ! -f "$bin" ]] || [[ "$f" -nt "$bin" ]]; then
    needs_pack=1
    break
  fi
done < <(find "$TEXT_DIR" -name '*.list' -print0 2>/dev/null || true)

should_xray=0
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(MIHOMO/|rule-sets/|scripts/build-xray.py)'; then
  should_xray=1
fi
if [[ "$needs_pack" -eq 1 ]]; then
  should_xray=1
fi

if [[ "$should_xray" -eq 1 ]] && git diff --name-only -- MIHOMO rule-sets scripts/build-xray.py | grep -q .; then
  echo "pre-commit: незастейдженные исходники (MIHOMO/, rule-sets/, scripts/build-xray.py)." >&2
  echo "pre-commit: добавь их в коммит или убери из рабочей копии — иначе XRAY соберётся не из индекса." >&2
  exit 1
fi

if [[ "$needs_pack" -eq 1 ]]; then
  echo "pre-commit: упаковка rule-sets/mrs…"
  "$ROOT/scripts/mrs-tool.sh" pack
  git add "$BIN_DIR"/*.mrs
  git add -u -- rule-sets/mrs/text
fi

if [[ "$should_xray" -eq 1 ]]; then
  echo "pre-commit: сборка XRAY…"
  python3 "$ROOT/scripts/build-xray.py"
  git add XRAY
fi

exit 0
